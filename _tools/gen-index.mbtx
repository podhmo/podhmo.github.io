///|
import {
  "moonbitlang/core/env",
}

///|
fn parse_args(args : ArrayView[String]) -> (String, Array[String]) {
  let files : Array[String] = []
  // deno parseArgs と同様 `--` はオプション終端。以降は位置引数として扱い
  // `--` 自体は含めない
  for i = 0, baseurl = "", opts_done = false; i < args.length(); {
    let arg = args[i]
    if opts_done {
      files.push(arg)
      continue i + 1, baseurl, opts_done
    } else if arg == "--" {
      continue i + 1, baseurl, true
    } else if arg == "--baseurl" {
      if i + 1 < args.length() {
        continue i + 2, args[i + 1], opts_done
      }
      continue i + 1, baseurl, opts_done
    } else if arg.has_prefix("--baseurl=") {
      continue i + 1, arg[10:].to_owned(), opts_done
    } else if arg == "--debug" {
      continue i + 1, baseurl, opts_done
    } else {
      files.push(arg)
      continue i + 1, baseurl, opts_done
    }
  } nobreak {
    (baseurl, files)
  }
}

///|
fn main {
  let (baseurl, files) = parse_args(@env.args()[1:])
  println("<!DOCTYPE html>")
  println("<html lang=\"ja\">")
  println(
    "<head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"with=device-width, initial-scale=1.0\"></head>",
  )
  println("<ul>")
  for filename in files {
    println("<li><a href=\"\{baseurl}\{filename}\">\{filename}</a></li>")
  }
  println("</ul>")
  println("</html>")
}
