///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/http",
  "moonbitlang/async@0.22.4/io",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
/// Agent Skill リポジトリ/gist から markdown 群を取り寄せ、
/// Prompt Template Clipper 形式 (chatgpt/Template.md と同じ) の
/// WritingSkills.md を生成する。
///
/// github リポジトリは GitHub API (git/trees) でディレクトリの中身を列挙して取り込む。
/// API の rate limit (未認証 60 req/h) に当たる場合は GITHUB_TOKEN を設定する。
///
/// 使い方: sync-writing-skills [output.md]

///|
/// 取り込み元
enum Origin {
  /// github リポジトリの dir 配下で、拡張子が exts のいずれかに一致するファイルすべて。
  /// excludes は dir からの相対パスの prefix。SKILL.md は常に先頭に置く。
  GitHubDir(
    repo~ : String,
    branch~ : String,
    dir~ : String,
    exts~ : Array[String],
    excludes~ : Array[String]
  )
  /// 単一ファイル
  Url(url~ : String, title~ : String)
}

///|
struct SkillSource {
  template_name : String
  description : String
  origin : Origin
}

///|
struct SkillFile {
  url : String
  title : String
}

///|
let header_chunk : String =
  #|# 日本語推敲スキル
  #|
  #|https://qiita.com/inoyu-qiita/items/0ffe6e74ecaf3aaa8b14 で取り上げられた writing skill をプロンプトテンプレートにしたもの。
  #|
  #|ℹ️ このファイルは tools/sync-writing-skills.mbtx で生成している
  #|

///|
let skill_0_description : String =
  #|AIが生成した不自然な日本語を読みやすく直す writing skill。文の骨格(誰が・何を・どうした)や比喩動詞を具体化するタイプ。
  #|
  #|- 出典: https://github.com/nanaism/yomiyasu (MIT)
  #|- 参考: https://qiita.com/inoyu-qiita/items/0ffe6e74ecaf3aaa8b14
  #|- scripts/ は python3 (標準ライブラリのみ) で実行可能。ファイルに書き出せば SKILL.md の lint → check run → verify がそのまま動く (tools/test_yomiyasu.py で確認)。チャットのみで使う場合は SKILL.md の「Pythonが実行できない環境」の手順で代替する
  #|- scripts/yomiyasu_hook.py は Claude Code のフック用のため含めない

///|
let skill_1_description : String =
  #|仕事の日本語文書を読みやすく書く・直す writing skill。「設計 → 執筆 → 検査 → 収束」の工程を持ち、文書タイプ別の型 (references/doctypes/) を含む。
  #|
  #|- 出典: https://github.com/coji/natural-japanese (MIT)
  #|- 参考: https://qiita.com/inoyu-qiita/items/0ffe6e74ecaf3aaa8b14
  #|- scripts/ は uv run scripts/lint.py 等で実行 (PEP 723)。uv がない環境では references/manual-checklist.md を使う

///|
let skill_2_description : String =
  #|日本語の技術文書・書籍原稿の文章規範。パラグラフライティング、論証の厳密さ、読み手の負荷、LLM っぽい空句の禁止などを定める。
  #|
  #|- 出典: https://gist.github.com/k16shikano/fd287c3133457c4fd8f5601d34aa817d (Unlicense)
  #|- 参考: https://qiita.com/inoyu-qiita/items/0ffe6e74ecaf3aaa8b14

///|
let skill_3_description : String =
  #|コーディングエージェントの応答を ADHD フレンドリーにする output style skill。回答を先に出し、手順を番号付きにし、脱線を抑えるタイプ。日本語推敲ではなく応答スタイルのルール集。
  #|
  #|- 出典: https://github.com/ayghri/i-have-adhd (MIT)
  #|- SKILL.md のみで動作。リポジトリの python 群は評価ハーネス用でありチャット利用では不要

///|
let skill_4_description : String =
  #|日本語の文章からAI臭を取り除く Claude Skill。立場 → 主体 → 構造 → 語彙 → 記号の優先順位でレビュー・修正するタイプ。hardikpandya/stop-slop の日本語版。
  #|
  #|- 出典: https://github.com/iKora128/stop-ai-slop-jp (MIT)
  #|- 元版: https://github.com/hardikpandya/stop-slop

///|
let skills : Array[SkillSource] = [
  {
    template_name: "yomiyasu",
    description: skill_0_description,
    origin: GitHubDir(
      repo="nanaism/yomiyasu",
      branch="main",
      dir="skills/yomiyasu",
      exts=[".md", ".txt", ".py"],
      excludes=["LICENSE", "UNICODE-LICENSE.txt", "scripts/yomiyasu_hook.py"],
    ),
  },
  {
    template_name: "natural-japanese",
    description: skill_1_description,
    origin: GitHubDir(
      repo="coji/natural-japanese",
      branch="main",
      dir="skills/natural-japanese",
      exts=[".md", ".py"],
      excludes=["scripts/fixtures/"],
    ),
  },
  {
    template_name: "japanese-tech-writing",
    description: skill_2_description,
    origin: Url(
      url="https://gist.githubusercontent.com/k16shikano/fd287c3133457c4fd8f5601d34aa817d/raw/SKILL.md",
      title="SKILL.md",
    ),
  },
  {
    template_name: "i-have-adhd",
    description: skill_3_description,
    origin: GitHubDir(
      repo="ayghri/i-have-adhd",
      branch="main",
      dir="skills/i-have-adhd",
      exts=[".md"],
      excludes=[],
    ),
  },
  {
    template_name: "stop-ai-slop-jp",
    description: skill_4_description,
    origin: GitHubDir(
      repo="iKora128/stop-ai-slop-jp",
      branch="main",
      dir="",
      exts=[".md"],
      excludes=["README", "CHANGELOG"],
    ),
  },
]

///|
async fn fetch_text(url : String) -> String {
  let (res, data) = @http.get(url)
  if !(200 <= res.code && res.code < 300) {
    fail("fetch failed: \{res.code} \{res.reason} (\{url})")
  }
  data.text()
}

///|
fn github_headers() -> Map[@http.CaseInsensitiveString, String] {
  let m : Map[@http.CaseInsensitiveString, String] = Map([])
  m["User-Agent"] = "sync-writing-skills"
  m["Accept"] = "application/vnd.github+json"
  match @env.get_env_var("GITHUB_TOKEN") {
    Some(token) if token != "" => m["Authorization"] = "Bearer \{token}"
    _ => ()
  }
  m
}

///|
/// GitHub API (git/trees?recursive=1) で dir 配下のファイルを列挙する。
async fn list_github_dir(
  repo~ : String,
  branch~ : String,
  dir~ : String,
  exts~ : Array[String],
  excludes~ : Array[String],
) -> Array[SkillFile] {
  let url = "https://api.github.com/repos/\{repo}/git/trees/\{branch}?recursive=1"
  let (res, data) = @http.get(url, headers=github_headers())
  if !(200 <= res.code && res.code < 300) {
    let body = data.text() catch { _ => "" }
    fail("github api error: \{res.code} \{res.reason} (\{url}) \{body}")
  }
  let prefix = if dir == "" { "" } else { dir + "/" }
  let titles : Array[String] = []
  guard data.json() is { "tree": Array(entries), .. } else {
    fail("unexpected github api response (\{url})")
  }
  for entry in entries {
    guard entry is { "type": String("blob"), "path": String(path), .. } else {
      continue
    }
    guard path.has_prefix(prefix) else { continue }
    let title = path[prefix.length():].to_owned()
    if exts.iter().any(fn(ext) { title.has_suffix(ext) }) &&
      !excludes.iter().any(fn(ex) { title.has_prefix(ex) }) {
      titles.push(title)
    }
  }
  // tree はパス順で返る。SKILL.md だけ先頭に移す
  let titles = [
    ..titles.filter(fn(t) { t == "SKILL.md" }),
    ..titles.filter(fn(t) { t != "SKILL.md" }),
  ]
  let raw_base = "https://raw.githubusercontent.com/\{repo}/\{branch}/\{prefix}"
  titles.map(fn(title) { { url: raw_base + title, title, } })
}

///|
async fn resolve_files(origin : Origin) -> Array[SkillFile] {
  match origin {
    GitHubDir(repo~, branch~, dir~, exts~, excludes~) =>
      list_github_dir(repo~, branch~, dir~, exts~, excludes~)
    Url(url~, title~) => [{ url, title, }]
  }
}

///|
/// 本文中の最長バッククォート列より長い fence を返す (最小3)。
/// JS の /`{3,}/g 相当: 最長ランが 3 未満でも結果は `` ``` `` になる。
fn fence_for(body : String) -> String {
  let (max_run, _cur) = for c in body; max_run = 0, cur = 0 {
    let cur = if c == '`' { cur + 1 } else { 0 }
    let max_run = if cur > max_run { cur } else { max_run }
    continue max_run, cur
  } nobreak {
    (max_run, cur)
  }
  let n = if max_run + 1 > 3 { max_run + 1 } else { 3 }
  "`".repeat(n)
}

///|
fn lang_for(title : String) -> String {
  if title.has_suffix(".py") {
    "py"
  } else if title.has_suffix(".txt") {
    "txt"
  } else {
    "md"
  }
}

///|
async fn main {
  let argv = @env.args()
  let output = if argv.length() > 1 { argv[1] } else { "../WritingSkills.md" }
  let chunks : Array[String] = []
  chunks.push(header_chunk)
  for skill in skills {
    chunks.push("## \{skill.template_name}\n\n\{skill.description}\n")
    for file in resolve_files(skill.origin) {
      let body = fetch_text(file.url).trim().to_owned()
      let fence = fence_for(body)
      chunks.push(
        "\{fence}\{lang_for(file.title)}:\{file.title}\n\{body}\n\{fence}",
      )
    }
  }
  let content = chunks.join("\n\n") + "\n"
  @fs.write_file(output, content)
  println("wrote \{output} (\{content.length()} chars)")
}
