///|
async fn fetch_text(url : String) -> String {
  let (res, data) = @http.get(url)
  if !(200 <= res.code && res.code < 300) {
    fail("fetch failed: \{res.code} \{res.reason} (\{url})")
  }
  data.text()
}

///|
/// 本文中の最長バッククォート列より長い fence を返す (最小3)。
/// JS の /`{3,}/g 相当: 最長ランが 3 未満でも結果は `` ``` `` になる。
fn fence_for(body : String) -> String {
  let (max_run, _cur) = for c in body; max_run = 0, cur = 0 {
    let cur = if c == '`' { cur + 1 } else { 0 }
    let max_run = if cur > max_run { cur } else { max_run }
    continue max_run, cur
  } nobreak {
    (max_run, cur)
  }
  let n = if max_run + 1 > 3 { max_run + 1 } else { 3 }
  "`".repeat(n)
}

///|
async fn main {
  let argv = @env.args()
  let output = if argv.length() > 1 { argv[1] } else { "../WritingSkills.md" }
  let chunks : Array[String] = []
  chunks.push(header_chunk)
  for skill in skills {
    chunks.push("## \{skill.template_name}\n\n\{skill.description}\n")
    for file in skill.files {
      let body = fetch_text(file.url).trim().to_owned()
      let fence = fence_for(body)
      let lang = if file.title.has_suffix(".py") { "py" } else { "md" }
      chunks.push("\{fence}\{lang}:\{file.title}\n\{body}\n\{fence}")
    }
  }
  let content = chunks.join("\n\n") + "\n"
  @fs.write_file(output, content)
  println("wrote \{output} (\{content.length()} chars)")
}
